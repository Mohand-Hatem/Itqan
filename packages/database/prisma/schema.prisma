// Itqan database schema. Source of truth for columns: docs/04-database.md.
// Conventions: UUIDv7 ids, snake_case tables and columns, UTC timestamptz.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  teacher
  assistant
  student
}

enum TenantStatus {
  active
  deleted
}

enum MembershipStatus {
  active
  suspended
}

enum UserStatus {
  active
  suspended
}

enum DeviceStatus {
  active
  pending
  revoked
}

enum SupportRequestType {
  device_change
  sign_out_other
  general
}

enum SupportRequestStatus {
  open
  approved
  rejected
  closed
}

model Tenant {
  id          String       @id @default(uuid(7)) @db.Uuid
  slug        String       @unique
  name        String
  status      TenantStatus @default(active)
  pausedRoles Role[]       @default([]) @map("paused_roles")
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz

  memberships     Membership[]
  auditLogs       AuditLog[]
  sessions        Session[]
  supportRequests SupportRequest[]

  @@map("tenants")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  twoFactorEnabled Boolean?   @default(false) @map("two_factor_enabled")
  maxDevices       Int        @default(1) @map("max_devices")
  status           UserStatus @default(active)
  isSuperAdmin     Boolean    @default(false) @map("is_super_admin")

  sessions               Session[]
  accounts               Account[]
  twofactors             TwoFactor[]
  memberships            Membership[]
  auditLogs              AuditLog[]
  devices                Device[]
  decidedSupportRequests SupportRequest[] @relation("SupportRequestDecidedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for staff and super admin sessions (no device rules).
  deviceId  String?  @map("device_id") @db.Uuid
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // Null on the super admin host.
  tenantId  String?  @map("tenant_id") @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("sessions")
}

// Global, not per tenant: one browser counts once across all tenant subdomains (ADR-004).
// Stores only sha256 of the cookie secret, never the secret.
model Device {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  name            String?
  userAgent       String?      @map("user_agent")
  fingerprintHint String?      @map("fingerprint_hint")
  status          DeviceStatus @default(active)
  secretHash      String       @map("secret_hash")
  lastSeenAt      DateTime?    @map("last_seen_at") @db.Timestamptz
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  supportRequests SupportRequest[]

  @@index([userId, status])
  @@map("devices")
}

// Device change, sign-out-other-device and general support requests (docs/04, docs/05 §5–6).
model SupportRequest {
  id              String               @id @default(uuid(7)) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  membershipId    String               @map("membership_id") @db.Uuid
  type            SupportRequestType
  status          SupportRequestStatus @default(open)
  message         String?
  // device_change only: the browser that asked, bound until staff decide.
  pendingDeviceId String?              @map("pending_device_id") @db.Uuid
  decidedById     String?              @map("decided_by") @db.Uuid
  decidedAt       DateTime?            @map("decided_at") @db.Timestamptz
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  pendingDevice Device?    @relation(fields: [pendingDeviceId], references: [id], onDelete: SetNull)
  decidedBy     User?      @relation("SupportRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([membershipId, type, status])
  @@map("support_requests")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

model Membership {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  role              Role
  status            MembershipStatus @default(active)
  guardianConsentAt DateTime?        @map("guardian_consent_at") @db.Timestamptz
  phone             String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  supportRequests SupportRequest[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// Insert-only: application code never updates or deletes rows (step 2.8).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  // Null for platform (super admin) actions.
  tenantId    String?  @map("tenant_id") @db.Uuid
  // Null for system jobs.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  meta        Json     @default("{}")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
