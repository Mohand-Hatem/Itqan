// Itqan database schema. Source of truth for columns: docs/04-database.md.
// Conventions: UUIDv7 ids, snake_case tables and columns, UTC timestamptz.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  teacher
  assistant
  student
}

enum TenantStatus {
  active
  deleted
}

enum MembershipStatus {
  active
  suspended
}

enum UserStatus {
  active
  suspended
}

enum DeviceStatus {
  active
  pending
  revoked
}

enum CourseStatus {
  draft
  published
  archived
}

enum EnrollmentStatus {
  active
  terminated
}

enum EnrollmentSource {
  invitation
  code
  manual
}

enum SupportRequestType {
  device_change
  sign_out_other
  general
}

enum SupportRequestStatus {
  open
  approved
  rejected
  closed
}

enum MediaProvider {
  r2
}

enum MediaStatus {
  pending
  ready
  failed
}

enum DownloadPolicy {
  view_only
  downloadable
}

// Which R2 bucket holds the file: content = private, public = public URL (docs/03 §4).
enum MediaPurpose {
  content
  public
}

// folder/chapter/lecture hold other items; file/video point to a media asset (docs/04, step 7.4).
enum ContentKind {
  folder
  chapter
  lecture
  file
  video
}

model Tenant {
  id          String       @id @default(uuid(7)) @db.Uuid
  slug        String       @unique
  name        String
  status      TenantStatus @default(active)
  pausedRoles Role[]       @default([]) @map("paused_roles")
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz

  memberships     Membership[]
  auditLogs       AuditLog[]
  sessions        Session[]
  supportRequests SupportRequest[]
  courses         Course[]
  invitations     Invitation[]
  enrollments     Enrollment[]
  codeBatches     AccessCodeBatch[]
  accessCodes     AccessCode[]
  mediaAssets     MediaAsset[]
  contentItems    ContentItem[]
  lessonProgress  LessonProgress[]

  @@map("tenants")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  twoFactorEnabled Boolean?   @default(false) @map("two_factor_enabled")
  maxDevices       Int        @default(1) @map("max_devices")
  status           UserStatus @default(active)
  isSuperAdmin     Boolean    @default(false) @map("is_super_admin")

  sessions               Session[]
  accounts               Account[]
  twofactors             TwoFactor[]
  memberships            Membership[]
  auditLogs              AuditLog[]
  devices                Device[]
  decidedSupportRequests SupportRequest[]  @relation("SupportRequestDecidedBy")
  createdInvitations     Invitation[]      @relation("InvitationCreatedBy")
  redeemedInvitations    Invitation[]      @relation("InvitationRedeemedBy")
  grantedEnrollments     Enrollment[]      @relation("EnrollmentGrantedBy")
  terminatedEnrollments  Enrollment[]      @relation("EnrollmentTerminatedBy")
  createdCodeBatches     AccessCodeBatch[] @relation("BatchCreatedBy")
  revokedCodeBatches     AccessCodeBatch[] @relation("BatchRevokedBy")
  redeemedAccessCodes    AccessCode[]      @relation("CodeRedeemedBy")
  uploadedMediaAssets    MediaAsset[]      @relation("MediaUploadedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for staff and super admin sessions (no device rules).
  deviceId  String?  @map("device_id") @db.Uuid
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // Null on the super admin host.
  tenantId  String?  @map("tenant_id") @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("sessions")
}

// Global, not per tenant: one browser counts once across all tenant subdomains (ADR-004).
// Stores only sha256 of the cookie secret, never the secret.
model Device {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  name            String?
  userAgent       String?      @map("user_agent")
  fingerprintHint String?      @map("fingerprint_hint")
  status          DeviceStatus @default(active)
  secretHash      String       @map("secret_hash")
  lastSeenAt      DateTime?    @map("last_seen_at") @db.Timestamptz
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  supportRequests SupportRequest[]

  @@index([userId, status])
  @@map("devices")
}

// Device change, sign-out-other-device and general support requests (docs/04, docs/05 §5–6).
model SupportRequest {
  id              String               @id @default(uuid(7)) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  membershipId    String               @map("membership_id") @db.Uuid
  type            SupportRequestType
  status          SupportRequestStatus @default(open)
  message         String?
  // device_change only: the browser that asked, bound until staff decide.
  pendingDeviceId String?              @map("pending_device_id") @db.Uuid
  decidedById     String?              @map("decided_by") @db.Uuid
  decidedAt       DateTime?            @map("decided_at") @db.Timestamptz
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  pendingDevice Device?    @relation(fields: [pendingDeviceId], references: [id], onDelete: SetNull)
  decidedBy     User?      @relation("SupportRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([membershipId, type, status])
  @@map("support_requests")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

model Membership {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  role              Role
  status            MembershipStatus @default(active)
  guardianConsentAt DateTime?        @map("guardian_consent_at") @db.Timestamptz
  phone             String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  supportRequests SupportRequest[]
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// Insert-only: application code never updates or deletes rows (step 2.8).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  // Null for platform (super admin) actions.
  tenantId    String?  @map("tenant_id") @db.Uuid
  // Null for system jobs.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  meta        Json     @default("{}")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Course {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  title            String
  description      String?
  thumbnailAssetId String?      @map("thumbnail_asset_id") @db.Uuid
  status           CourseStatus @default(draft)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  codeBatches  AccessCodeBatch[]
  accessCodes  AccessCode[]
  contentItems ContentItem[]

  @@index([tenantId, status, id(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("courses")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  courseIds  String[]  @map("course_ids") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  redeemedAt DateTime? @map("redeemed_at") @db.Timestamptz
  redeemedBy String?   @map("redeemed_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser  User   @relation("InvitationCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  redeemedByUser User?  @relation("InvitationRedeemedBy", fields: [redeemedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([tenantId, expiresAt])
  @@index([tenantId, redeemedAt])
  @@map("invitations")
}

model Enrollment {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  status       EnrollmentStatus @default(active)
  source       EnrollmentSource
  grantedBy    String           @map("granted_by") @db.Uuid
  terminatedBy String?          @map("terminated_by") @db.Uuid
  terminatedAt DateTime?        @map("terminated_at") @db.Timestamptz
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership       Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grantedByUser    User       @relation("EnrollmentGrantedBy", fields: [grantedBy], references: [id], onDelete: Cascade)
  terminatedByUser User?      @relation("EnrollmentTerminatedBy", fields: [terminatedBy], references: [id], onDelete: SetNull)

  @@unique([membershipId, courseId])
  @@index([tenantId, status])
  @@index([courseId, status])
  @@map("enrollments")
}

// Batch of access codes generated for a course (docs/04-database.md, FR-E02).
model AccessCodeBatch {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  name          String?
  codeCount     Int       @map("code_count")
  redeemedCount Int       @default(0) @map("redeemed_count")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  createdById   String    @map("created_by") @db.Uuid
  revokedById   String?   @map("revoked_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdByUser User   @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  revokedByUser User?  @relation("BatchRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  codes AccessCode[]

  @@index([tenantId, courseId, createdAt(sort: Desc)])
  @@index([tenantId, revokedAt])
  @@map("access_code_batches")
}

// Single-use course access code (HMAC-hashed, docs/04-database.md, FR-E02).
model AccessCode {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  batchId      String    @map("batch_id") @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  serialNumber Int       @map("serial_number")
  codeHash     String    @unique @map("code_hash")
  codePrefix   String    @map("code_prefix")
  redeemedAt   DateTime? @map("redeemed_at") @db.Timestamptz
  redeemedBy   String?   @map("redeemed_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch          AccessCodeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  redeemedByUser User?           @relation("CodeRedeemedBy", fields: [redeemedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, batchId, serialNumber])
  @@index([tenantId, batchId, redeemedAt, revokedAt])
  @@index([codeHash])
  @@map("access_codes")
}

// A file in R2 (docs/04-database.md, FR-C03). Bytes live in R2, never here.
model MediaAsset {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  provider       MediaProvider  @default(r2)
  purpose        MediaPurpose
  storageKey     String         @unique @map("storage_key")
  originalName   String         @map("original_name")
  mimeType       String         @map("mime_type")
  fileSize       BigInt         @map("file_size")
  durationSec    Int?           @map("duration_sec")
  status         MediaStatus    @default(pending)
  downloadPolicy DownloadPolicy @default(view_only) @map("download_policy")
  uploadedBy     String         @map("uploaded_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: removing a user must not drop the record of files that still sit in R2.
  uploadedByUser User          @relation("MediaUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)
  contentItems   ContentItem[]

  @@index([tenantId, status, createdAt])
  @@map("media_assets")
}

// A node of a course's content tree (docs/04-database.md, FR-C01/C02). Adjacency list, depth 1..5.
model ContentItem {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  courseId    String      @map("course_id") @db.Uuid
  parentId    String?     @map("parent_id") @db.Uuid
  kind        ContentKind
  title       String
  sortOrder   Int         @map("sort_order")
  depth       Int
  assetId     String?     @map("asset_id") @db.Uuid
  publishedAt DateTime?   @map("published_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent   ContentItem?     @relation("ContentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ContentItem[]    @relation("ContentTree")
  // Restrict: a file still used by the tree cannot be removed.
  asset    MediaAsset?      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  progress LessonProgress[]

  @@index([tenantId, courseId])
  @@index([courseId, parentId, sortOrder])
  @@index([assetId])
  @@map("content_items")
}

// A student's progress on one content item (docs/04-database.md, FR-C07, step 7.10).
model LessonProgress {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  membershipId     String    @map("membership_id") @db.Uuid
  contentItemId    String    @map("content_item_id") @db.Uuid
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  videoPositionSec Int?      @map("video_position_sec")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership  Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([membershipId, contentItemId])
  @@index([tenantId, membershipId, updatedAt(sort: Desc)])
  @@map("lesson_progress")
}
