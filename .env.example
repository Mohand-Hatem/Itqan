# Local database (Docker, `npm run db:up`). Local-only credentials, not secrets.
DATABASE_URL=postgresql://itqan:itqan@localhost:5433/itqan
TEST_DATABASE_URL=postgresql://itqan:itqan@localhost:5433/itqan_test

# Neon `dev` branch, the promotion target of `npm run db:promote:dev` (docs/10-dev-setup.md).
# Pooled (host contains -pooler) for the app; direct (no -pooler) for migrations.
# Use sslmode=verify-full. Never put the production branch here.
NEON_DEV_DATABASE_URL=
NEON_DEV_DIRECT_URL=

# Seed (`npm run db:seed`): first tenant, reachable at <slug>.localhost locally.
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Demo Academy
# Super admin account the seed will create once Better Auth exists (step 4.1).
SUPER_ADMIN_EMAIL=

# Authentication (Better Auth - step 4.1)
# Random 32-byte secret (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend - step 4.3)
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=
# Test sender used until custom domain is verified in step 10.9 (defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Destination email address to receive the verification test email in step 4.3
TEST_EMAIL_RECIPIENT=

# Platform Domains & Hosting
# The apex or root domain configured in Cloudflare (e.g., itqan.com).
# Tenants are <slug>.<root>, super admin is admin.<root>.
# Leave empty locally: the API uses `localhost` (drahmed.localhost). Required in production.
PLATFORM_ROOT_DOMAIN=

# VPS Deployment Configuration (Hostinger VPS)
# IP address or hostname of your staging VPS server
VPS_HOST=
# SSH user on the VPS (typically root or a dedicated deploy user)
VPS_USER=
# SSH port (default is 22)
VPS_PORT=22

# Cloudflare Configuration
# Cloudflare API token with Zone:DNS:Edit permissions for wildcard DNS (*.staging.<root>)
CLOUDFLARE_API_TOKEN=
# Zone ID for your root domain in Cloudflare Dashboard
CLOUDFLARE_ZONE_ID=

# Cloudflare R2 file storage (step 7.1, docs/10-dev-setup.md §R2). Dev buckets only here.
# Account ID: Cloudflare dashboard → R2 → right sidebar ("Account ID").
R2_ACCOUNT_ID=
# Dashboard → R2 → Manage API tokens → Create token, "Object Read & Write", limited to the two
# buckets below. Cloudflare shows the secret once; paste both values here, never in chat.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Course files and videos (private) and logos/thumbnails (public), e.g. itqan-dev-private / itqan-dev-public.
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
# The public bucket's URL: bucket → Settings → Public access (r2.dev URL for now), no trailing slash.
R2_PUBLIC_URL=
